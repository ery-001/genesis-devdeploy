# DevDeploy local development defaults (safe to copy to .env)
# Never commit real secrets.

# --- API ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://devdeploy:devdeploy@127.0.0.1:5432/devdeploy
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://127.0.0.1:43127,http://localhost:43127
WEB_ORIGIN=http://127.0.0.1:43127
API_PUBLIC_URL=http://127.0.0.1:8741

# Auth: FastAPI httpOnly session cookies (not NextAuth)
# AUTH_MOCK_MODE=true enables demonstrable OAuth/SMS without real credentials.
AUTH_MOCK_MODE=true
MOCK_OTP_CODE=000000
SESSION_SECRET=devdeploy-local-session-secret-change-me
SESSION_COOKIE_NAME=devdeploy_session
SESSION_COOKIE_SECURE=false

# Real user-sign-in OAuth (used when AUTH_MOCK_MODE=false).
# Callback URL for every provider (register in each console):
#   http://127.0.0.1:8741/api/v1/auth/oauth/<provider>/callback
# Providers: github | google | apple | microsoft
# GitHub login uses GITHUB_CLIENT_* if set, else GITHUB_APP_CLIENT_ID/SECRET.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# GitHub App for *repository* install — separate from user sign-in OAuth.
# Leave empty + GITHUB_MOCK_MODE=true for local demos without a real App.
# The App's User authorization callback URL should match the github callback above.
GITHUB_MOCK_MODE=true
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=devdeploy-local-webhook-secret
GITHUB_APP_SLUG=devdeploy-local

# Runtime adapters — prefer real Docker/kind locally; mock when tools missing.
# See docs/real-infra.md
BUILD_MOCK_MODE=false
K8S_MOCK_MODE=false
AWS_MOCK_MODE=true
AWS_REGION=us-east-1
ECR_REGISTRY=
EKS_CLUSTER_NAME=
# Prefer 127.0.0.1 on Windows (localhost may resolve to ::1 and time out).
LOCAL_REGISTRY=127.0.0.1:5001
KIND_CLUSTER_NAME=devdeploy
K8S_CONTEXT=kind-devdeploy
K8S_INGRESS_HOST_PORT=8088
# BUILD_CONTEXT_DIR=/absolute/path/to/app   # optional override

# Shareable HTTPS link after deploy (cloudflared quick tunnel → *.trycloudflare.com).
# Ephemeral: lasts while the API/cloudflared process runs. Set false to disable.
PUBLIC_TUNNEL_ENABLED=true
PUBLIC_TUNNEL_PROVIDER=cloudflared
# NGROK_AUTHTOKEN=   # only if PUBLIC_TUNNEL_PROVIDER=ngrok


# --- Web ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8741
PORT=43127
