# DevDeploy local development defaults (safe to copy to .env)
# Never commit real secrets.

# --- API ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://devdeploy:devdeploy@127.0.0.1:5432/devdeploy
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://127.0.0.1:43127,http://localhost:43127
WEB_ORIGIN=http://127.0.0.1:43127
API_PUBLIC_URL=http://127.0.0.1:8741

# Auth: FastAPI httpOnly session cookies (not NextAuth)
# AUTH_MOCK_MODE=true enables demonstrable OAuth/SMS without real credentials.
AUTH_MOCK_MODE=true
MOCK_OTP_CODE=000000
SESSION_SECRET=devdeploy-local-session-secret-change-me
SESSION_COOKIE_NAME=devdeploy_session
SESSION_COOKIE_SECURE=false

# Optional real OAuth credentials (used when AUTH_MOCK_MODE=false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub App for *repository* install (Milestone 2+) — separate from user sign-in
GITHUB_APP_ID=

# --- Web ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8741
PORT=43127
